<Window x:Class="InventoryApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:vm="clr-namespace:InventoryApp.ViewModels"
        Title="Inventory App"  Height="800" Width="1000" MinWidth="1000">


    <Window.DataContext>
        <vm:MainWindowViewModel />
    </Window.DataContext>

    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Background="LightGray" Height="40">
            <Button Content="Продукти" Width="100" Margin="5" Command="{Binding ShowProductsCommand}" />
            <Button Content="Категории" Width="100" Margin="5" Command="{Binding ShowCategoriesCommand}" />
            <Button Content="Доставчици" Width="100" Margin="5" Command="{Binding ShowSupplierCommand}" />
            <Button Content="Количка" Width="100" Margin="5" Command="{Binding ShowCartCommand}" />
            <Button Content="История на поръчки" Width="150" Margin="5" Command="{Binding ShowCategoriesCommand}" />
        </StackPanel>

        <!--<views:ProductListView />-->

        <ContentControl Content="{Binding CurrentView}" />
    </DockPanel>
</Window>