<UserControl x:Class="InventoryApp.Views.CategoryListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:InventoryApp.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="800">

    <UserControl.DataContext>
        <vm:CategoryViewModel />
    </UserControl.DataContext>

    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="10">
            <Button Content="Добави" Margin="5" Command="{Binding AddCommand}" />
            <Button Content="Редактирай" Margin="5" Command="{Binding EditCommand}" IsEnabled="{Binding CanEdit}" />
            <Button Content="Изтрий" Margin="5" Command="{Binding DeleteCommand}" IsEnabled="{Binding CanDelete}" />
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ListBox ItemsSource="{Binding Categories}"
         SelectionMode="Multiple"
         Background="Transparent"
         BorderThickness="0"             
                     xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
                     xmlns:local="clr-namespace:InventoryApp.Behaviors" >

                <i:Interaction.Behaviors>
                    <local:SelectedItemsBehaviorListBox SelectedListItems="{Binding SelectedCategories}" />
                </i:Interaction.Behaviors>

                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="Gray" BorderThickness="1" Margin="5" Padding="10">
                            <StackPanel Orientation="Vertical">
                                <TextBlock Text="{Binding Name}" FontSize="16" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

        </ScrollViewer>
    </DockPanel>
</UserControl>
